# cline CLI harness image for the coding-agent benchmark.
#
#   podman build -t bench/cline:pinned -f containers/Containerfile.cline containers
#
# CLI path (runner invokes this exact path): /opt/harness/bin/cline
# Pinned CLI version: cline 3.0.55
#
# Ran natively until now, which is why its config and home came from the developer's machine
# rather than from a blank slate. Containerizing it brings it under the same guarantee as the rest:
# an empty HOME in the image, per-run config and data dirs inside the bind-mounted workdir, and the
# real API key never crossing the boundary.

# Shared base: node:22-slim pinned by digest, plus git/ripgrep/ca-certificates and an empty HOME.
# See Containerfile.base for why the harnesses share a base but not an image.
FROM localhost/bench/base:pinned

RUN npm install -g --prefix /opt/harness cline@3.0.55 \
 && rm -rf /root/.npm /tmp/*

ENV PATH=/opt/harness/bin:$PATH

WORKDIR /work

ENTRYPOINT []
CMD ["/opt/harness/bin/cline", "--version"]
