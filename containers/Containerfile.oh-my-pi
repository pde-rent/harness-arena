# oh-my-pi harness image for the coding-agent benchmark.
#
# Build (tiny context, everything is downloaded):
#   podman build -t bench/oh-my-pi:pinned -f containers/Containerfile.oh-my-pi containers
#
# CLI path (runner invokes this exact path): /opt/harness/bin/pi
# Pinned versions: @earendil-works/pi-coding-agent 0.84.2 + oh-my-pi 0.2.0
#
# oh-my-pi is an EXTENSION, not a separate agent: `pi install oh-my-pi` registers a package that
# pi auto-discovers and loads, replacing the stock system prompt with an orchestrator prompt and
# adding its own agents and skills. So this image is the same pinned pi as the `pi` harness with
# the extension present, and the runner must NOT pass pi's -ne/-ns/-np/-na switches, which would
# disable extensions, skills, prompts and agents -- exactly what is under measurement.
#
# No host ~/.pi, ~/.agents or ~/.config is ever read; HOME=/home/bench starts empty.

# The pinned pi image, so this differs from the `pi` harness by the extension and nothing else.
FROM localhost/bench/pi:pinned

# `pi install` writes two things: a `packages` entry in the agent dir's settings.json, and an npm
# tree under that agent dir. The runner gives every run a fresh agent dir inside the bind-mounted
# workdir and can only materialise files there, not directory trees -- so the npm half cannot be
# recreated per run without network access at measurement time. Staging the package at a fixed
# path instead lets the per-run settings.json register it by path, which `pi list` resolves.
RUN npm install -g --prefix /opt/build oh-my-pi@0.2.0 \
 && mv /opt/build/lib/node_modules/oh-my-pi /opt/harness/oh-my-pi \
 && rm -rf /opt/build /root/.npm /tmp/*

ENV PATH=/opt/harness/bin:$PATH \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    DO_NOT_TRACK=1

WORKDIR /work

ENTRYPOINT []
CMD ["/opt/harness/bin/pi", "--version"]
