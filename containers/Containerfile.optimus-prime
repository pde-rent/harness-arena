# Containerfile.optimus-prime
#
# Harness: optimus-prime -- local fork of the pi coding agent
#   @earendil-works/pi-coding-agent 0.7.2, git 3701f4e00e0d91cd182f3b86d2ee426e63717b0a
#
# Context is the package root (the CLI resolves skills/theme/export-html relative
# to package.json), narrowed to ~14M by the sibling ignorefile.optimus-prime allow-list so
# node_modules/src/docs/*.map are never tarred. The fork repo is READ-ONLY:
# nothing here installs or builds inside it, we only COPY prebuilt output.
#
# BUILD:
#   podman build \
#     -f /private/tmp/bench-harnesses/containers/Containerfile.optimus-prime \
#     --ignorefile /private/tmp/bench-harnesses/containers/ignorefile.optimus-prime \
#     -t bench/optimus-prime:pinned \
#     $HOME/Work/optimus-prime/packages/coding-agent
#
# RUN (runner invokes):
#   podman run --rm -v <workdir>:/work:rw -w /work \
#     -e OPTIMUS_CODING_AGENT_DIR=/work/.bench-agentdir \
#     -e DO_NOT_TRACK=1 \
#     bench/optimus-prime:pinned \
#     bun /opt/harness/bundle/cli.js -p "<prompt>" --mode json \
#       --provider bench --model <model> -nc --no-session \
#       --daemon-socket /work/.bench-daemon.sock

# oven/bun:1.3-slim (bun 1.3.x, Debian slim) pinned by digest
FROM docker.io/oven/bun@sha256:6068a9d40e9fc5c4519891edb63dfc5935c393fe2228eb9a5b7f472b444b5ee2

# git + ripgrep: the agent shells out to both. python3/ipython: for model-authored
# Python. ipython lives in a venv on PATH; no network needed at run time.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git ripgrep python3 python3-venv \
 && python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --disable-pip-version-check ipython \
 && /opt/venv/bin/pip uninstall -y pip setuptools 2>/dev/null || true \
 && apt-get purge -y python3-venv \
 && apt-get autoremove -y \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /root/.cache /tmp/* \
 && find /opt/venv -name '__pycache__' -type d -prune -exec rm -rf {} +

ENV PATH=/opt/venv/bin:$PATH \
    HOME=/home/bench \
    PI_PACKAGE_DIR=/opt/harness \
    DO_NOT_TRACK=1 \
    XDG_CONFIG_HOME=/home/bench/.config \
    XDG_CACHE_HOME=/home/bench/.cache \
    XDG_DATA_HOME=/home/bench/.local/share \
    BUN_INSTALL=/home/bench/.bun

# Writable in-image HOME; 0777 so the image also works with --user <uid>.
RUN mkdir -p /home/bench/.config /home/bench/.cache /home/bench/.local/share /work \
 && chmod -R 0777 /home/bench /work

# Prebuilt, self-contained bundle. Entry: /opt/harness/bundle/cli.js
COPY dist/bundle/ /opt/harness/bundle/
# PI_PACKAGE_DIR pins package-relative asset lookup (getPackageDir()) to
# /opt/harness, so these must keep their in-package relative layout.
COPY package.json /opt/harness/package.json
COPY dist/skills/ /opt/harness/dist/skills/
COPY dist/core/export-html/ /opt/harness/dist/core/export-html/
COPY dist/modes/interactive/theme/ /opt/harness/dist/modes/interactive/theme/
COPY dist/modes/interactive/assets/ /opt/harness/dist/modes/interactive/assets/

WORKDIR /work
