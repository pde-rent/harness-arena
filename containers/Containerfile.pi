# pi harness image for the coding-agent benchmark.
#
#   podman build -t bench/pi:pinned -f containers/Containerfile.pi containers
#
# CLI path (runner invokes this exact path): /opt/harness/bin/pi
# Pinned CLI version: @earendil-works/pi-coding-agent 0.84.2
#
# This image is also the base for bench/oh-my-pi:pinned, which adds only the extension. That makes
# the control/treatment pair exact: the two images differ by the extension and nothing else, so a
# token or latency delta between them cannot be an artefact of a differently-built runtime.
#
# No host ~/.pi or ~/.agents is ever read; HOME comes from the base and starts empty.

# Shared base: node:22-slim pinned by digest, plus git/ripgrep/ca-certificates and an empty HOME.
# See Containerfile.base for why the harnesses share a base but not an image.
FROM localhost/bench/base:pinned

RUN npm install -g --prefix /opt/harness @earendil-works/pi-coding-agent@0.84.2 \
 && rm -rf /root/.npm /tmp/*

ENV PATH=/opt/harness/bin:$PATH

WORKDIR /work

ENTRYPOINT []
CMD ["/opt/harness/bin/pi", "--version"]
